// Schema chuyển sang MySQL, khớp CHÍNH XÁC theo ERD do bạn cung cấp
// (mermaid-diagram.png) — 16 bảng. Đây là bản thay thế hoàn toàn schema
// lý do thiết kế tại docs/database.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================================================
// CORE: USERS & VOCABULARIES
// ==================================================

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)

  /// Tuỳ chọn cá nhân (thuật toán, giao diện, âm thanh, level khởi điểm...) - JSON tự do, validate ở tầng service.
  settings      Json?

  dailyGoal     Int @default(20) @map("daily_goal")
  currentStreak Int @default(0) @map("current_streak")
  longestStreak Int @default(0) @map("longest_streak")
  totalXp       Int @default(0) @map("total_xp")

  /// Mốc đổi mật khẩu gần nhất qua luồng "quên mật khẩu": JWT cấp TRƯỚC mốc này bị từ chối (xem authenticateToken).
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userVocabularies UserVocabulary[]
  userSentences    UserSentence[]
  userAchievements UserAchievement[]
  dailyStatistics  DailyStatistic[]
  xpTransactions   XpTransaction[]
  studySessions    StudySession[]
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]
  handwritingAttempts HandwritingAttempt[]

  @@map("users")
}

model Vocabulary {
  id           String  @id @default(uuid()) @db.Char(36)
  hanzi        String  @db.VarChar(50)
  pinyin       String  @db.VarChar(200)
  meaning      String  @db.VarChar(500)
  pronunciation String? @db.VarChar(200)
  audioUrl     String? @map("audio_url") @db.VarChar(500)
  /// HSK 1-6 hoặc tuỳ mức phân loại - lưu dạng chuỗi tự do (vd "HSK1"), không ràng buộc enum để dễ mở rộng.
  level        String? @db.VarChar(20)
  partOfSpeech String? @map("part_of_speech") @db.VarChar(50)
  notes        String? @db.Text

  // ---- Dữ liệu làm giàu (AI sinh bằng `npm run prisma:enrich`, người dùng/admin có thể sửa) ----
  /// Âm Hán Việt, vd 学校 → "học hiệu".
  hanViet      String? @map("han_viet") @db.VarChar(100)
  /// Dạng phồn thể, chỉ có khi khác giản thể.
  traditional  String? @db.VarChar(50)
  /// Lượng từ đi kèm (danh từ), vd "个", "本".
  measureWord  String? @map("measure_word") @db.VarChar(100)
  /// Cách dùng / cấu trúc ngữ pháp thường gặp (tiếng Việt).
  usage        String? @db.Text
  /// [{ word, pinyin, note }]
  synonyms     Json?
  /// [{ word, pinyin, note }]
  antonyms     Json?
  /// [{ phrase, pinyin, meaning }]
  collocations Json?
  /// Thời điểm AI làm giàu xong (null = chưa làm; script dựa vào đây để chạy tiếp, không làm lại).
  enrichedAt   DateTime? @map("enriched_at")
  /// "provider:model" đã sinh dữ liệu, để truy vết chất lượng.
  enrichedBy   String? @map("enriched_by") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  examples         VocabularyExample[]
  tags             VocabularyTag[]
  userVocabularies UserVocabulary[]
  userSentences    UserSentence[]
  exerciseAttempts ExerciseAttempt[]
  handwritingAttempts HandwritingAttempt[]

  @@index([hanzi])
  @@index([pinyin])
  @@index([enrichedAt])
  @@map("vocabularies")
}

/// Ví dụ câu cho 1 từ vựng - tách bảng riêng (1 vocab có thể có N câu ví dụ),
/// khác với thiết kế cũ (nhồi 1 example duy nhất vào chính bảng vocabularies).
model VocabularyExample {
  id             String @id @default(uuid()) @db.Char(36)
  vocabularyId   String @map("vocabulary_id") @db.Char(36)
  sentenceHanzi  String @map("sentence_hanzi") @db.VarChar(500)
  sentencePinyin String @map("sentence_pinyin") @db.VarChar(500)
  sentenceMeaning String @map("sentence_meaning") @db.VarChar(500)
  audioUrl       String? @map("audio_url") @db.VarChar(500)
  /// Giải thích ngắn (tiếng Việt) về cách dùng từ trong câu.
  explanation    String? @db.Text
  /// Nguồn câu: manual | seed | ai
  source         String  @default("manual") @db.VarChar(20)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_examples")
}

model Tag {
  id   String @id @default(uuid()) @db.Char(36)
  name String @unique @db.VarChar(50)

  vocabularies VocabularyTag[]

  @@map("tags")
}

/// Bảng trung gian many-to-many giữa Vocabulary <-> Tag.
model VocabularyTag {
  vocabularyId String @map("vocabulary_id") @db.Char(36)
  tagId        String @map("tag_id") @db.Char(36)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([vocabularyId, tagId])
  @@index([tagId])
  @@map("vocabulary_tags")
}

// ==================================================
// HỌC TẬP CÁ NHÂN HOÁ (theo user)
// ==================================================

/// Danh sách từ đang học của user + trạng thái tổng hợp.
/// LƯU Ý: interval/ease_factor SM-2 KHÔNG lưu ở đây - chỉ lưu ở SrsReview
/// (bảng lịch sử). next_review_at ở đây là bản SAO CHÉP (denormalize) từ
/// SrsReview mới nhất, chỉ để truy vấn nhanh "từ nào đến hạn ôn" mà không
/// cần join ngược mỗi lần - xem services/srs.service.ts.
model UserVocabulary {
  id           String @id @default(uuid()) @db.Char(36)
  userId       String @map("user_id") @db.Char(36)
  vocabularyId String @map("vocabulary_id") @db.Char(36)

  /// "new" | "learning" | "mastered"
  status String @default("new") @db.VarChar(20)

  masteryLevel   Int @default(0) @map("mastery_level")
  reviewCount    Int @default(0) @map("review_count")
  correctCount   Int @default(0) @map("correct_count")
  incorrectCount Int @default(0) @map("incorrect_count")

  /// Ghi chú / mẹo nhớ RIÊNG của user (khác vocabularies.notes là dữ liệu dùng chung).
  note     String? @db.Text
  mnemonic String? @db.Text

  learnedAt      DateTime? @map("learned_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  srsReviews SrsReview[]

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@index([nextReviewAt])
  @@map("user_vocabularies")
}

/// Lịch sử TỪNG lần ôn tập theo thuật toán SM-2 thật (không phải bảng SRS
/// đơn giản như thiết kế cũ). previous_/new_ ease_factor + interval cho
/// phép audit lại toàn bộ quá trình thay đổi lịch ôn của 1 từ.
model SrsReview {
  id               String @id @default(uuid()) @db.Char(36)
  userVocabularyId String @map("user_vocabulary_id") @db.Char(36)

  /// Chất lượng câu trả lời theo thang SM-2: 0-5 (0 = quên hoàn toàn, 5 = nhớ hoàn hảo).
  quality Int

  previousInterval    Int   @map("previous_interval")
  newInterval         Int   @map("new_interval")
  previousEaseFactor  Float @map("previous_ease_factor")
  newEaseFactor       Float @map("new_ease_factor")

  reviewedAt   DateTime @default(now()) @map("reviewed_at")
  nextReviewAt DateTime @map("next_review_at")

  userVocabulary UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)

  @@index([userVocabularyId])
  @@index([nextReviewAt])
  @@map("srs_reviews")
}

/// User tự đặt câu với 1 từ vựng để luyện tập - có thể được chấm/sửa
/// (correction) sau đó (thủ công hoặc AI ở giai đoạn sau).
model UserSentence {
  id           String  @id @default(uuid()) @db.Char(36)
  userId       String  @map("user_id") @db.Char(36)
  vocabularyId String  @map("vocabulary_id") @db.Char(36)
  sentence     String  @db.Text
  pinyin       String? @db.VarChar(500)
  correction   String? @db.Text
  /// "pending" | "reviewed"
  status       String  @default("pending") @db.VarChar(20)

  /// --- Câu do hệ thống sinh (AI / từ câu ví dụ có sẵn) mà user đã LƯU. Câu tự viết để các cột này null/mặc định. ---
  /// Bản dịch tiếng Việt - có giá trị thì câu dùng được cho các dạng bài dịch/điền từ/sắp xếp (xem exercise.service.ts).
  translation  String? @db.VarChar(500)
  /// Giải thích ngắn về ngữ pháp/cách dùng.
  explanation  String? @db.Text
  topic        String? @db.VarChar(50)
  /// Trình độ ƯỚC LƯỢNG (vd "HSK 2"), không phải dữ liệu đã xác minh.
  level        String? @db.VarChar(20)
  /// "manual" (user tự viết) | "ai" | "existing" (lấy từ câu ví dụ có sẵn)
  source       String  @default("manual") @db.VarChar(20)
  /// Các từ trong danh sách học của user thực sự xuất hiện trong câu: [{ vocabularyId, hanzi, role: "target" | "known" }].
  /// `vocabularyId` ở trên là từ mục tiêu CHÍNH (dùng cho bài luyện và SRS).
  usedWords    Json?   @map("used_words")

  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vocabularyId])
  @@map("user_sentences")
}

// ==================================================
// EXERCISE ENGINE & STUDY SESSIONS
// ==================================================

/// Catalog các LOẠI bài luyện tập (không phải ngân hàng câu hỏi cụ thể).
/// Ví dụ 7 dòng cố định: QUIZ, REVERSE_QUIZ, PINYIN, LISTENING, WRITING,
/// SENTENCE, SPEAKING (seed sẵn - xem prisma/seed.ts). Câu hỏi thực tế vẫn
/// được ExerciseGenerator sinh động từ Vocabulary tại runtime; exercise_id
/// ở exercise_attempts chỉ tham chiếu tới LOẠI bài đã dùng.
model Exercise {
  id          String  @id @default(uuid()) @db.Char(36)
  /// Khoá loại bài, vd "QUIZ", "REVERSE_QUIZ" - dùng để tra cứu trong code.
  type        String  @unique @db.VarChar(50)
  title       String  @db.VarChar(200)
  description String? @db.VarChar(500)

  attempts ExerciseAttempt[]

  @@map("exercises")
}

model StudySession {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)

  /// "mixed" | "daily_review" | "practice"
  sessionType String @map("session_type") @db.VarChar(20)

  totalQuestions Int @default(0) @map("total_questions")
  correctAnswers Int @default(0) @map("correct_answers")
  xpEarned       Int @default(0) @map("xp_earned")

  /// Kế hoạch câu hỏi do server sinh: [{ v: vocabularyId, t: exerciseType, e: exampleId | null }].
  /// Dùng để từ chối đáp án không thuộc phiên / sai loại bài. Null = phiên cũ (trước khi có cột này), không kiểm tra.
  plan        Json?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts ExerciseAttempt[]

  @@index([userId, startedAt])
  @@map("study_sessions")
}

model ExerciseAttempt {
  id             String  @id @default(uuid()) @db.Char(36)
  sessionId      String  @map("session_id") @db.Char(36)
  exerciseId     String  @map("exercise_id") @db.Char(36)
  vocabularyId   String  @map("vocabulary_id") @db.Char(36)
  userAnswer     String  @map("user_answer") @db.VarChar(500)
  isCorrect      Boolean @map("is_correct")
  responseTimeMs Int?    @map("response_time_ms")

  createdAt DateTime @default(now()) @map("created_at")

  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  vocabulary Vocabulary   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([vocabularyId])
  @@map("exercise_attempts")
}

// ==================================================
// GAMIFICATION: ACHIEVEMENTS, XP, THỐNG KÊ
// ==================================================

model Achievement {
  id          String @id @default(uuid()) @db.Char(36)
  /// Khoá định danh dùng trong code để check điều kiện, vd "WORDS_50".
  code        String @unique @db.VarChar(50)
  name        String @db.VarChar(200)
  description String? @db.VarChar(500)
  icon        String? @db.VarChar(100)
  xpReward    Int    @default(0) @map("xp_reward")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  achievementId String   @map("achievement_id") @db.Char(36)
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

/// Tổng hợp số liệu học tập THEO NGÀY/user - phục vụ biểu đồ tuần/tháng ở
/// Dashboard & Statistics mà không cần quét toàn bộ exercise_attempts mỗi lần.
model DailyStatistic {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  statisticDate  DateTime @map("statistic_date") @db.Date

  wordsLearned    Int @default(0) @map("words_learned")
  wordsReviewed   Int @default(0) @map("words_reviewed")
  correctAnswers  Int @default(0) @map("correct_answers")
  incorrectAnswers Int @default(0) @map("incorrect_answers")
  studyMinutes    Int @default(0) @map("study_minutes")
  xpEarned        Int @default(0) @map("xp_earned")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statisticDate])
  @@index([userId, statisticDate])
  @@map("daily_statistics")
}

/// Sổ cái (ledger) mọi lần cộng/trừ XP - thay vì chỉ tăng users.total_xp
/// trực tiếp, giữ lại LỊCH SỬ vì sao có XP đó (audit, hiển thị "hoạt động
/// gần đây" ở Dashboard).
model XpTransaction {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  amount Int
  /// vd "exercise_correct" | "daily_review_bonus" | "achievement"
  source String @db.VarChar(50)
  /// id của bản ghi liên quan (exercise_attempt_id / achievement_id...), tự do theo `source`.
  referenceId String? @map("reference_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_transactions")
}

// ==================================================
// THÔNG BÁO
// ==================================================

/// Thông báo trong ứng dụng (nhắc ôn SRS, mở khoá thành tích, tổng kết phiên...).
model Notification {
  id       String  @id @default(uuid()) @db.Char(36)
  userId   String  @map("user_id") @db.Char(36)
  /// "srs" | "achievement" | "ai" | "system"
  category String  @db.VarChar(30)
  title    String  @db.VarChar(200)
  body     String? @db.Text
  /// Route nội bộ của frontend để điều hướng khi bấm vào thông báo, vd "/review".
  link     String? @db.VarChar(200)
  isRead   Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==================================================
// QUÊN MẬT KHẨU & NHẬN DIỆN CHỮ VIẾT
// ==================================================

/// Token đặt lại mật khẩu. CHỈ lưu hash SHA-256 của token (token gốc chỉ nằm trong email).
/// Dùng một lần (usedAt), có hạn (expiresAt).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Lịch sử nhận diện chữ viết. KHÔNG lưu ảnh/nét vẽ - chỉ kết quả tối thiểu.
model HandwritingAttempt {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  /// Từ đang luyện (nếu có) - null khi nhận diện tự do hoặc từ đã bị xoá.
  vocabularyId   String?  @map("vocabulary_id") @db.Char(36)
  /// "recognized" | "low_confidence" | "unrecognized" | "no_content"
  status         String   @db.VarChar(20)
  predictedChar  String?  @map("predicted_char") @db.VarChar(8)
  confidence     Float?
  /// Chữ dự đoán có nằm trong các chữ của từ đang luyện hay không (null nếu không có từ mục tiêu / chưa nhận diện được).
  matchesTarget  Boolean? @map("matches_target")
  createdAt      DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([vocabularyId])
  @@map("handwriting_attempts")
}
