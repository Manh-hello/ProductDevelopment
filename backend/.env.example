PORT=5000
DATABASE_URL="mysql://username:password@localhost:3306/chinese_vocabulary"

# JWT dùng cho Authentication (đã triển khai).
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Origin frontend được phép gọi API (CORS), nhiều origin cách nhau bằng dấu phẩy. Bỏ trống = cho phép tất cả (chỉ dev).
CORS_ORIGIN="http://localhost:5173"
# Lệch múi giờ so với UTC (phút) để tính "ngày học"/streak. 420 = UTC+7 (Việt Nam).
TZ_OFFSET_MINUTES=420

# ---- AI tra cứu từ vựng & tạo câu (TUỲ CHỌN) ----
# Để trống = tính năng AI báo "chưa cấu hình" (ứng dụng vẫn chạy bình thường).
# AI_API_KEY chỉ để ở backend, KHÔNG commit key thật.
# AI_PROVIDER: "openai" (hoặc gateway tương thích OpenAI, kết hợp AI_BASE_URL) | "gemini"
AI_PROVIDER=""
AI_API_KEY=""
# Tên model theo tài liệu của nhà cung cấp bạn chọn (không có mặc định).
AI_MODEL=""
# Chỉ dùng với openai-compatible gateway, ví dụ "https://api.openai.com/v1".
AI_BASE_URL=""
# Timeout mỗi lần gọi AI (ms).
AI_TIMEOUT_MS="20000"

# ---- URL frontend (dùng dựng liên kết trong email đặt lại mật khẩu) ----
FRONTEND_URL=http://localhost:5173
# Đặt 1 (hoặc số hop proxy) khi chạy sau nginx/load balancer để giới hạn tần suất theo IP đúng. Local: 0.
TRUST_PROXY=0

# ---- Email / SMTP cho "Quên mật khẩu" (TUỲ CHỌN) ----
# Để trống MAIL_HOST/MAIL_FROM = tính năng báo "chưa cấu hình". KHÔNG commit thông tin SMTP thật.
# Dev: có thể dùng Mailpit/MailHog (MAIL_HOST=127.0.0.1, MAIL_PORT=1025, không cần USER/PASSWORD).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---- Nhận diện chữ viết (TUỲ CHỌN) - xem docs/handwriting-model.md ----
# URL dịch vụ model (handwriting-service). Để trống = API nhận diện báo "chưa cấu hình".
HANDWRITING_SERVICE_URL=
HANDWRITING_SERVICE_TOKEN=
HANDWRITING_TIMEOUT_MS=8000
HANDWRITING_MIN_CONFIDENCE=0.5
HANDWRITING_MAX_IMAGE_BYTES=2000000
