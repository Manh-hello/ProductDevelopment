PORT=5000
DATABASE_URL="mysql://username:password@localhost:3306/chinese_vocabulary"

# JWT dùng cho Authentication (đã triển khai).
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Origin frontend được phép gọi API (CORS), nhiều origin cách nhau bằng dấu phẩy. Bỏ trống = cho phép tất cả (chỉ dev).
CORS_ORIGIN="http://localhost:5173"
# Lệch múi giờ so với UTC (phút) để tính "ngày học"/streak. 420 = UTC+7 (Việt Nam).
TZ_OFFSET_MINUTES=420

# ---- AI tra cứu từ vựng & tạo câu (TUỲ CHỌN) ----
# Để trống = tính năng AI báo "chưa cấu hình" (ứng dụng vẫn chạy bình thường).
# AI_API_KEY chỉ để ở backend, KHÔNG commit key thật.
# AI_PROVIDER: "openai" (hoặc gateway tương thích OpenAI, kết hợp AI_BASE_URL) | "gemini"
AI_PROVIDER=""
AI_API_KEY=""
# Tên model theo tài liệu của nhà cung cấp bạn chọn (không có mặc định).
AI_MODEL=""
# Chỉ dùng với openai-compatible gateway, ví dụ "https://api.openai.com/v1".
AI_BASE_URL=""
# Timeout mỗi lần gọi AI (ms).
AI_TIMEOUT_MS="20000"
